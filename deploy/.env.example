# Copy to .env (same folder as docker-compose.yml). Never commit .env.
PRIME_DOMAIN=tasks.example.org
ACME_EMAIL=admin@example.org
# Image tag from GHCR, e.g. 2.7.1-p1 for git tag prime-v2.7.1-p1. "latest" = newest prime-v* tag.
PRIME_TASKS_VERSION=latest
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
VIKUNJA_SERVICE_SECRET=
